{
  "name": "iobroker.radar-trap",
  "version": "2.2.2",
  "engines": {
    "node": ">=22.19.0"
  },
  "description": "Detect speed traps and obstacles on routes",
  "author": {
    "name": "Steiger04",
    "email": "steiger04@posteo.de"
  },
  "homepage": "https://github.com/Steiger04/ioBroker.radar-trap",
  "license": "MIT",
  "keywords": [
    "speed traps",
    "obstacles on routes"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:Steiger04/ioBroker.radar-trap.git"
  },
  "types": "../build/",
  "dependencies": {
    "@feathersjs/configuration": "^4.5.15",
    "@feathersjs/errors": "^4.5.15",
    "@feathersjs/express": "^4.5.15",
    "@feathersjs/feathers": "^4.5.15",
    "@feathersjs/socketio": "^4.5.15",
    "@feathersjs/transport-commons": "^4.5.15",
    "@iobroker/adapter-core": "^3.4.3",
    "@mapbox/mapbox-sdk": "^0.16.0",
    "@mapbox/polyline": "^1.2.1",
    "@seald-io/nedb": "^4.0.3",
    "@sinclair/typebox": "^0.32.34",
    "@turf/helpers": "^6.5.0",
    "@turf/turf": "^6.5.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "croner": "^8.0.2",
    "cross-fetch": "^4.0.0",
    "express": "^4.19.2",
    "feathers-hooks-common": "^6.1.5",
    "feathers-nedb": "^6.0.0",
    "helmet": "^6.1.5",
    "lodash": "^4.17.21",
    "rxjs": "^7.8.1",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@iobroker/adapter-dev": "^1.3.0",
    "@iobroker/build-tools": "^3.0.3",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.2.2",
    "@iobroker/types": "^7.2.5",
    "@tsconfig/node22": "^22.0.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/lodash": "^4.17.6",
    "@types/mapbox__mapbox-sdk": "^0.14.0",
    "@types/mapbox__polyline": "^1.0.5",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "main": "build/main.js",
  "files": [
    "admin/",
    "build/",
    "public/",
    "widgets/",
    "io-package.json",
    "LICENSE"
  ],
  "directories": {
    "test": "src/server/test/",
    "lib": "src/server",
    "config": "src/server/config/"
  },
  "scripts": {
    "build": "tsx tasks.ts",
    "build:backend": "tsx tasks.ts --backend",
    "build:admin": "tsx tasks.ts --admin",
    "build:widgets": "tsx tasks.ts --widgets",
    "build:devices": "tsx tasks.ts --devices",
    "build:wc": "tsx tasks.ts --wc",
    "watch": "tsc -p tsconfig.build.json --watch",
    "check": "tsc -p tsconfig.json --noEmit",
    "check:tasks": "tsc -p tsconfig.tasks.json",
    "check:admin": "npm --prefix src-admin run typecheck",
    "check:widgets": "npm --prefix src-widgets run typecheck",
    "check:devices": "npm --prefix src-devices run typecheck",
    "check:wc": "npm --prefix src-webcomponents run typecheck",
    "lint": "eslint -c eslint.config.mjs",
    "test:package": "mocha test/packageFiles --exit",
    "test:integration": "mocha test/integrationAdapter --exit",
    "test": "npm run test:package",
    "translate": "translate-adapter -b admin/i18n/en.json",
    "release": "release-script --noPush -y",
    "release-patch": "release-script patch --yes",
    "release-minor": "release-script minor --yes",
    "release-major": "release-script major --yes",
    "update-packages": "npx npm-check-updates --upgrade"
  },
  "bugs": {
    "url": "https://github.com/Steiger04/ioBroker.radar-trap/issues"
  },
  "readmeFilename": "README.md"
}
