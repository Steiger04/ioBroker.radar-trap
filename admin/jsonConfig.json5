{
    // The configuration of radar-trap. What JSON-Config cannot do itself - the search of an address, the editor of an
    // area and the map of the traps - are web components of `src-admin` (built into `admin/custom/`).
    i18n: true,
    type: 'tabs',
    items: {
        _mapTab: {
            type: 'panel',
            label: 'Map',
            items: {
                _map: {
                    type: 'custom',
                    webComponent: 'custom/radar-trap-map.json',
                    xs: 12,
                    sm: 12,
                    md: 12,
                    lg: 12,
                    xl: 12,
                    height: 'max(400px, calc(100vh - 260px))',
                    settings: {
                        instance: 'radar-trap.${_instance}',
                        token: '${data.settings.mbxAccessToken}',
                        style: '${data.mapStyle}',
                        changed: '${_changed}',
                        // no frame: the map is part of the form
                        form: true,
                    },
                },
            },
        },
        _routesTab: {
            type: 'panel',
            label: 'Routes',
            items: {
                _routesInfo: {
                    type: 'staticText',
                    text: 'routes_info',
                    xs: 12,
                    sm: 12,
                    md: 12,
                    lg: 12,
                    xl: 12,
                },
                routes: {
                    type: 'accordion',
                    newLine: true,
                    titleAttr: 'description',
                    xs: 12,
                    sm: 12,
                    md: 12,
                    lg: 12,
                    xl: 12,
                    items: [
                        {
                            type: 'text',
                            attr: '_id',
                            hidden: true,
                            defaultFunc: 'Date.now().toString(36) + Math.random().toString(36).substring(2, 6)',
                        },
                        {
                            type: 'text',
                            attr: 'description',
                            label: 'Name',
                            defaultFunc: "'Route ' + (arrayIndex + 1)",
                            xs: 12,
                            sm: 12,
                            md: 6,
                            lg: 6,
                            xl: 6,
                        },
                        {
                            type: 'custom',
                            attr: 'src',
                            label: 'Start',
                            webComponent: 'custom/radar-trap-address.json',
                            height: 64,
                            default: null,
                            newLine: true,
                            xs: 12,
                            sm: 12,
                            md: 6,
                            lg: 6,
                            xl: 6,
                            settings: {
                                token: '${globalData.settings.mbxAccessToken}',
                            },
                        },
                        {
                            type: 'custom',
                            attr: 'dst',
                            label: 'Destination',
                            webComponent: 'custom/radar-trap-address.json',
                            height: 64,
                            default: null,
                            xs: 12,
                            sm: 12,
                            md: 6,
                            lg: 6,
                            xl: 6,
                            settings: {
                                token: '${globalData.settings.mbxAccessToken}',
                            },
                        },
                        {
                            type: 'select',
                            attr: 'profile',
                            label: 'Profile',
                            default: 'driving',
                            newLine: true,
                            xs: 12,
                            sm: 6,
                            md: 4,
                            lg: 4,
                            xl: 4,
                            options: [
                                { value: 'driving', label: 'Car' },
                                { value: 'driving-traffic', label: 'Car with traffic' },
                                { value: 'cycling', label: 'Bicycle' },
                                { value: 'walking', label: 'On foot' },
                            ],
                            help: 'profile_help',
                        },
                        {
                            type: 'select',
                            attr: 'exclusions',
                            label: 'Avoid',
                            multiple: true,
                            default: [],
                            xs: 12,
                            sm: 6,
                            md: 4,
                            lg: 4,
                            xl: 4,
                            options: [
                                {
                                    value: 'motorway',
                                    label: 'Motorways',
                                    hidden: "data.profile === 'cycling' || data.profile === 'walking'",
                                },
                                {
                                    value: 'toll',
                                    label: 'Toll roads',
                                    hidden: "data.profile === 'cycling' || data.profile === 'walking'",
                                },
                                { value: 'ferry', label: 'Ferries' },
                                {
                                    value: 'unpaved',
                                    label: 'Unpaved roads',
                                    hidden: "data.profile === 'cycling' || data.profile === 'walking'",
                                },
                                {
                                    value: 'cash_only_tolls',
                                    label: 'Cash-only tolls',
                                    hidden: "data.profile === 'cycling'",
                                },
                            ],
                        },
                        {
                            type: 'number',
                            attr: 'maxTrapDistance',
                            label: 'Maximum distance from the route',
                            unit: 'm',
                            min: 1,
                            max: 100,
                            default: 10,
                            xs: 12,
                            sm: 6,
                            md: 4,
                            lg: 4,
                            xl: 4,
                            help: 'distance_help',
                        },
                        {
                            type: 'cron',
                            attr: 'cron',
                            label: 'Update',
                            default: '10 * * * *',
                            newLine: true,
                            xs: 12,
                            sm: 12,
                            md: 6,
                            lg: 6,
                            xl: 6,
                        },
                    ],
                },
            },
        },
        _areasTab: {
            type: 'panel',
            label: 'Areas',
            items: {
                _areasInfo: {
                    type: 'staticText',
                    text: 'areas_info',
                    xs: 12,
                    sm: 12,
                    md: 12,
                    lg: 12,
                    xl: 12,
                },
                areas: {
                    type: 'accordion',
                    newLine: true,
                    titleAttr: 'description',
                    xs: 12,
                    sm: 12,
                    md: 12,
                    lg: 12,
                    xl: 12,
                    items: [
                        {
                            type: 'text',
                            attr: '_id',
                            hidden: true,
                            defaultFunc: 'Date.now().toString(36) + Math.random().toString(36).substring(2, 6)',
                        },
                        {
                            type: 'text',
                            attr: 'description',
                            label: 'Name',
                            defaultFunc: "'Area ' + (arrayIndex + 1)",
                            xs: 12,
                            sm: 12,
                            md: 6,
                            lg: 6,
                            xl: 6,
                        },
                        {
                            type: 'cron',
                            attr: 'cron',
                            label: 'Update',
                            default: '10 * * * *',
                            xs: 12,
                            sm: 12,
                            md: 6,
                            lg: 6,
                            xl: 6,
                        },
                        {
                            type: 'custom',
                            attr: 'areaPolygons',
                            label: 'Area',
                            webComponent: 'custom/radar-trap-area.json',
                            height: 440,
                            default: null,
                            newLine: true,
                            xs: 12,
                            sm: 12,
                            md: 12,
                            lg: 12,
                            xl: 12,
                            settings: {
                                token: '${globalData.settings.mbxAccessToken}',
                                style: '${globalData.mapStyle}',
                            },
                        },
                    ],
                },
            },
        },
        _settingsTab: {
            type: 'panel',
            label: 'Settings',
            items: {
                'settings.mbxAccessToken': {
                    type: 'text',
                    label: 'Mapbox token',
                    help: 'token_help',
                    xs: 12,
                    sm: 12,
                    md: 8,
                    lg: 6,
                    xl: 6,
                },
                _tokenLink: {
                    type: 'staticLink',
                    label: 'Get a Mapbox token',
                    icon: 'web',
                    href: 'https://account.mapbox.com/access-tokens/',
                    button: true,
                    variant: 'outlined',
                    xs: 12,
                    sm: 12,
                    md: 4,
                    lg: 3,
                    xl: 3,
                },
                mapStyle: {
                    type: 'select',
                    label: 'Style of the maps',
                    newLine: true,
                    xs: 12,
                    sm: 12,
                    md: 8,
                    lg: 6,
                    xl: 6,
                    options: [
                        { value: 'osm', label: 'OpenStreetMap' },
                        { value: 'osm-dark', label: 'OpenStreetMap, dark' },
                        { value: 'liberty', label: 'OpenFreeMap Liberty' },
                        { value: 'positron', label: 'OpenFreeMap Positron' },
                        {
                            value: 'mapbox-streets-v12',
                            label: 'Mapbox Streets',
                            hidden: '!data.settings.mbxAccessToken',
                        },
                        {
                            value: 'mapbox-outdoors-v12',
                            label: 'Mapbox Outdoors',
                            hidden: '!data.settings.mbxAccessToken',
                        },
                        {
                            value: 'mapbox-light-v11',
                            label: 'Mapbox Light',
                            hidden: '!data.settings.mbxAccessToken',
                        },
                        {
                            value: 'mapbox-dark-v11',
                            label: 'Mapbox Dark',
                            hidden: '!data.settings.mbxAccessToken',
                        },
                        {
                            value: 'mapbox-satellite-streets-v12',
                            label: 'Mapbox Satellite',
                            hidden: '!data.settings.mbxAccessToken',
                        },
                    ],
                    help: 'style_help',
                },
                'settings.feathersPort': {
                    type: 'port',
                    label: 'Port for the vis-2 widgets',
                    help: 'port_help',
                    min: 1024,
                    newLine: true,
                    xs: 12,
                    sm: 6,
                    md: 4,
                    lg: 3,
                    xl: 3,
                },
            },
        },
    },
}
