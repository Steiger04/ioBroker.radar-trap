{
    "manifestVersion": 1,
    "tag": "iob-radar-trap-area",
    "module": "./radar-trap-area.js",
    "name": {
        "en": "Area of radar traps",
        "de": "Gebiet für Blitzer"
    },
    "description": {
        "en": "Draws an area as a polygon or a circle, or takes a German county",
        "de": "Zeichnet ein Gebiet als Polygon oder Kreis oder übernimmt einen Landkreis"
    },
    "size": {
        "width": 600,
        "height": 440
    },
    "editsValue": true,
    "settings": {
        "type": "panel",
        "items": {
            "token": {
                "type": "text",
