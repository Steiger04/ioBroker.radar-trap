                            "ru": "Автоматически",
                            "pt": "Automático",
                            "nl": "Automatisch",
                            "fr": "Automatique",
                            "it": "Automatico",
                            "es": "Automático",
                            "pl": "Automatycznie",
                            "uk": "Автоматично",
                            "zh-cn": "自动"
                        }
                    },
                    {
                        "value": "summary",
                        "label": {
                            "en": "Number of traps only",
                            "de": "Nur die Anzahl",
                            "ru": "Только количество",
                            "pt": "Apenas o número",
                            "nl": "Alleen het aantal",
                            "fr": "Nombre seulement",
                            "it": "Solo il numero",
                            "es": "Solo el número",
                            "pl": "Tylko liczba",
                            "uk": "Лише кількість",
                            "zh-cn": "仅数量"
                        }
                    },
                    {
                        "value": "list",
                        "label": {
                            "en": "List of traps",
                            "de": "Liste der Hindernisse",
                            "ru": "Список ловушек",
                            "pt": "Lista de armadilhas",
                            "nl": "Lijst van vallen",
                            "fr": "Liste des pièges",
                            "it": "Elenco delle trappole",
                            "es": "Lista de trampas",
