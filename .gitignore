# No dot-directories except github/vscode
.*/
!.vscode/
!.github/

node_modules
data

# the compiled backend: built by `npm run build` and in the CI, never committed (common.nogit)
build
*.tsbuildinfo

#ignore .commitinfo created by ioBroker release script
.commitinfo

