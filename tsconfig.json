// Root tsconfig to set the settings and power editor support for all TS files of the backend
{
    "compileOnSave": true,
    "extends": "@tsconfig/node22/tsconfig.json",
    "compilerOptions": {
        // do not compile anything; this file is just to configure type checking
        // the compilation is configured in tsconfig.build.json
        "noEmit": true,

        "allowJs": false,
        "skipLibCheck": true, // Don't report errors in 3rd party definitions
        "noEmitOnError": true,
        "outDir": "./build/",
        "rootDir": "./src/",
        "removeComments": false,
        "module": "Node16",
        "moduleResolution": "node16",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "strict": true,
        "strictNullChecks": true,
        "strictPropertyInitialization": true,
        "target": "es2022",
        "sourceMap": true,
        "inlineSourceMap": false,
        "useUnknownInCatchVariables": false,
        // @types/mapbox__mapbox-sdk declares the sub paths (`@mapbox/mapbox-sdk/services/directions`) as ambient
        // modules, so it has to be loaded explicitly
        "types": ["@iobroker/types", "@types/node", "@types/mapbox__mapbox-sdk"],
        "paths": {
            // @turf/turf 6 has `exports` without a `types` condition: node16 resolution would not find its typings
            "@turf/turf": ["./node_modules/@turf/turf/index.d.ts"]
        }
    },
    // the front-ends (src-admin, src-widgets, src-devices, src-webcomponents, src-shared) have their own tsconfig
    "include": ["src/**/*.ts"],
    "exclude": ["build/**", "node_modules/**", "admin/**"]
}
